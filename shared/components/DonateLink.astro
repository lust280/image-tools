---
import { features } from '../features.config'

interface Props {
  locale: 'en' | 'ru'
}

const { locale } = Astro.props
const donate = features.donate
const show = donate.enabled && donate.url.length > 0
const label = donate.label[locale]
---

{
  show ? (
    <a class="donate" href={donate.url} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6 9.2c0-2.4 1.7-4 4.1-4 1.4 0 2.4.6 3.1 1.6.7-1 1.7-1.6 3.1-1.6 2.4 0 4.2 1.6 4.2 4 0 4.4-4.6 7.3-7.3 9.1-2.7-1.8-7.2-4.7-7.2-9.1Z"
        />
        <path fill="currentColor" d="M8 19.2h8v1.6H8z" opacity=".85" />
      </svg>
      {label}
    </a>
  ) : (
    <Fragment
      set:html={'<!-- Donate button disabled. Set features.donate.enabled and features.donate.url in shared/features.config.ts -->'}
    />
  )
}
