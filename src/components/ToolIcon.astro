---
interface Props {
  name: string
}
const { name } = Astro.props
---

<span class="tool-icon">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    {
      name === 'heic' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <rect x="9" y="3" width="14" height="26" rx="3" />
          <path d="M13 7h6" />
          <circle cx="16" cy="24" r="1.2" fill="currentColor" stroke="none" />
        </g>
      )
    }
    {
      name === 'jpg' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 6h10l6 6v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z" />
          <path d="M18 6v6h6M11 20l2.2-2.4 1.6 1.6 1.3-1.2L20 21" />
        </g>
      )
    }
    {
      name === 'png' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 6h10l6 6v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z" />
          <path d="M18 6v6h6" />
          <path d="M12 18h3v5M17 18c1.4 0 2.2.8 2.2 2.5S18.4 23 17 23h-1.2" />
        </g>
      )
    }
    {
      name === 'webp' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 11h18v10H7z" />
          <path d="M11 16.2 13.4 14l2 1.8 1.4-1.2L20 17.5" />
        </g>
      )
    }
    {
      name === 'compress' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 12V8h4M20 8h4v4M24 20v4h-4M12 24H8v-4" />
          <path d="M12 16h8" />
        </g>
      )
    }
    {
      name === 'resize' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 22 22 10" />
          <path d="M14 10h8v8M18 22H10v-8" />
        </g>
      )
    }
    {
      name === 'crop' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 8v14h14" />
          <path d="M8 10h14v14" />
        </g>
      )
    }
    {
      name === 'convert' && (
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 12h12l-3-3M25 20H13l3 3" />
        </g>
      )
    }
    {
      !['heic', 'jpg', 'png', 'webp', 'compress', 'resize', 'crop', 'convert'].includes(name) && (
        <rect x="7" y="7" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
      )
    }
  </svg>
</span>
