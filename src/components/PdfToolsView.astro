---
import Base from '../layouts/Base.astro'
import type { Locale } from '../lib/urls'
import { canonical, homePath, hrefFor } from '../lib/urls'
import { site } from '../../site.config'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = locale === 'ru'
  ? {
      path: '/ru/pdf-tools/',
      title: 'PDF-редактор бесплатно: сжать, подписать, объединить — Foto',
      description: 'Редактируйте PDF в браузере: добавляйте подпись и фото, сжимайте и поворачивайте страницы, объединяйте файлы и конвертируйте JPG в PDF. Без загрузки на сервер.',
      imageAlt: 'Foto — PDF-инструменты в браузере',
      crumb: 'PDF-инструменты',
      h1: 'Бесплатный PDF-редактор и инструменты онлайн',
      lede: 'Добавляйте текст, фото и подпись, сжимайте и поворачивайте PDF, удаляйте и переставляйте страницы, объединяйте документы и превращайте JPG в PDF. Файлы остаются в браузере.',
      merge: 'Объединить PDF',
      mergeHelp: 'Выберите два или больше PDF. Документы будут объединены в выбранном порядке.',
      chooseMany: 'Выбрать PDF-файлы',
      mergeButton: 'Объединить и скачать',
      extract: 'Извлечь страницы',
      extractHelp: 'Выберите PDF и укажите страницы или диапазоны, например: 1-3, 5.',
      chooseOne: 'Выбрать PDF',
      pagesLabel: 'Страницы',
      pagesPlaceholder: 'Например: 1-3, 5',
      extractButton: 'Создать PDF со страницами',
      localNote: 'Обработка выполняется на этом устройстве. Файлы не отправляются на сервер.',
      back: 'На главную',
      editor: 'Редактор PDF',
      editorHelp: 'Добавьте текст или изображение. Чтобы заменить фрагмент, сначала закройте его белой плашкой, затем добавьте новый текст.',
      chooseDocument: 'Открыть PDF',
      page: 'Страница',
      previous: 'Назад',
      next: 'Вперёд',
      mode: 'Действие',
      addText: 'Добавить текст',
      cover: 'Закрыть фрагмент',
      addImage: 'Добавить фото',
      textLabel: 'Текст',
      textPlaceholder: 'Введите текст',
      textSize: 'Размер текста',
      imageLabel: 'Фото (PNG или JPG)',
      imageWidth: 'Ширина фото',
      undo: 'Убрать последнее действие',
      save: 'Сохранить копию PDF',
      editorNote: 'Новый текст и фото добавляются поверх страницы. Белая плашка скрывает старый фрагмент только визуально и не удаляет его безопасно из файла. Замена не переносит соседний текст; для сканов нужен OCR.',
      editorReady: 'PDF открыт. Выберите действие и нажмите или протяните курсор по странице.',
      editorSaved: 'Готово. Изменённая копия скачана.',
      editorError: 'Не удалось открыть или сохранить PDF. Файл может быть повреждён или защищён паролем.',
      textMissing: 'Сначала введите текст.',
      imageMissing: 'Сначала выберите PNG- или JPG-фото.',
      faqTitle: 'Как работать с PDF онлайн',
      faqEditQ: 'Можно ли бесплатно добавить текст или фото в PDF?',
      faqEditA: 'Да. Откройте PDF в редакторе, выберите добавление текста или фото, укажите место на странице и сохраните изменённую копию. Инструмент добавляет содержимое поверх страницы.',
      faqReplaceQ: 'Можно ли заменить уже существующий текст?',
      faqReplaceA: 'Старый фрагмент можно закрыть белой областью и написать новый поверх него. Это визуальная правка: исходный текст не удаляется надёжно, а соседние строки не перестраиваются. Не используйте этот способ для сокрытия конфиденциальных данных.',
      faqMergeQ: 'Как объединить PDF или сохранить отдельные страницы?',
      faqMergeA: 'Для объединения выберите несколько PDF в нужном порядке и нажмите «Объединить и скачать». Для извлечения выберите один документ и укажите номера страниц или диапазоны, например 1-3, 5.',
      faqPrivacyQ: 'Загружаются ли мои PDF на сайт?',
      faqPrivacyA: 'Нет. Обработка выполняется в браузере на вашем устройстве; выбранные файлы не отправляются на сервер.',
      faqCompressQ: 'Как сжать PDF и уменьшить размер файла?',
      faqCompressA: 'Выберите PDF и качество сжатия. Страницы сохраняются как изображения: файл может стать меньше, но текст потеряет возможность выделения и поиска. Результат зависит от исходного документа.',
      faqPagesQ: 'Можно ли удалить, переставить или повернуть страницы?',
      faqPagesA: 'Да. Введите номера в нужном порядке, чтобы создать копию только с этими страницами, или укажите страницы для поворота на 90 градусов.',
      faqJpgQ: 'Как сделать PDF из JPG-фотографий?',
      faqJpgA: 'Выберите одно или несколько JPG-фото. Каждое будет помещено на отдельную страницу нового PDF.',
      switchLanguage: 'English version',
      compress: 'Сжать PDF', compressHelp: 'Уменьшите размер файла, преобразовав страницы в изображения.', compressQuality: 'Качество', compressButton: 'Сжать и скачать',
      pages: 'Страницы PDF', pagesHelp: 'Введите страницы в нужном порядке. Пропущенные номера будут удалены. Чтобы повернуть страницы, выберите номера ниже.', rotatePages: 'Страницы для поворота', pagesButton: 'Сохранить страницы', rotateButton: 'Повернуть на 90°',
      imagesPdf: 'JPG в PDF', imagesPdfHelp: 'Выберите один или несколько JPG. Каждое фото станет отдельной страницей.', imagesPdfButton: 'Создать PDF',
      sign: 'Подписать PDF', signHelp: 'Добавьте нарисованную подпись на страницу в редакторе.', signMode: 'Нарисовать подпись',
    }
  : {
      path: '/pdf-tools/',
      title: 'Free PDF Editor: Compress, Sign, Merge & Convert JPG — Foto',
      description: 'Edit PDFs in your browser: add a signature and photos, compress or rotate pages, merge files, and convert JPG to PDF. No server upload.',
      imageAlt: 'Foto — PDF tools in your browser',
      crumb: 'PDF tools',
      h1: 'Free PDF editor and online tools',
      lede: 'Add text, photos, and a signature; compress and rotate PDFs; remove or reorder pages; merge documents; and turn JPG images into PDF. Files stay in your browser.',
      merge: 'Merge PDFs',
      mergeHelp: 'Choose two or more PDFs. They will be merged in the order you select them.',
      chooseMany: 'Choose PDF files',
      mergeButton: 'Merge and download',
      extract: 'Extract pages',
      extractHelp: 'Choose a PDF and enter pages or ranges, for example: 1-3, 5.',
      chooseOne: 'Choose a PDF',
      pagesLabel: 'Pages',
      pagesPlaceholder: 'For example: 1-3, 5',
      extractButton: 'Create PDF with selected pages',
      localNote: 'Processing happens on this device. Files are not sent to a server.',
      back: 'Home',
      editor: 'PDF editor',
      editorHelp: 'Add text or an image. To replace a fragment, cover it with a white box first, then add the new text.',
      chooseDocument: 'Open PDF',
      page: 'Page',
      previous: 'Previous',
      next: 'Next',
      mode: 'Action',
      addText: 'Add text',
      cover: 'Cover an area',
      addImage: 'Add image',
      textLabel: 'Text',
      textPlaceholder: 'Enter text',
      textSize: 'Text size',
      imageLabel: 'Image (PNG or JPG)',
      imageWidth: 'Image width',
      undo: 'Remove last addition',
      save: 'Save edited PDF copy',
      editorNote: 'New text and images are placed over the page. A white box only hides old content visually; it does not securely remove it from the file. Replacement text does not reflow nearby text. Scanned pages need OCR.',
      editorReady: 'PDF opened. Choose an action, then click or drag on the page.',
      editorSaved: 'Done. Your edited copy has been downloaded.',
      editorError: 'Could not open or save the PDF. The file may be damaged or password protected.',
      textMissing: 'Enter some text first.',
      imageMissing: 'Choose a PNG or JPG image first.',
      faqTitle: 'How to work with PDFs online',
      faqEditQ: 'Can I add text or a photo to a PDF for free?',
      faqEditA: 'Yes. Open your PDF in the editor, choose add text or add image, place it on the page, and save an edited copy. Added content is placed over the page.',
      faqReplaceQ: 'Can I replace existing text in a PDF?',
      faqReplaceA: 'You can cover a fragment with a white area and place new text over it. This is a visual edit: the original text is not securely removed and nearby lines do not reflow. Do not use this method to hide confidential information.',
      faqMergeQ: 'How do I merge PDFs or save selected pages?',
      faqMergeA: 'To merge, select multiple PDFs in the order you want and choose Merge and download. To extract pages, select one PDF and enter page numbers or ranges such as 1-3, 5.',
      faqPrivacyQ: 'Are my PDF files uploaded to the website?',
      faqPrivacyA: 'No. Processing happens in your browser on your device; selected files are not sent to a server.',
      faqCompressQ: 'How do I compress a PDF and reduce its file size?',
      faqCompressA: 'Choose a PDF and a compression quality. Pages are saved as images: the file may get smaller, but text will no longer be selectable or searchable. Results depend on the source document.',
      faqPagesQ: 'Can I delete, reorder, or rotate PDF pages?',
      faqPagesA: 'Yes. Enter page numbers in the order you want to create a copy with those pages, or specify pages to rotate by 90 degrees.',
      faqJpgQ: 'How do I make a PDF from JPG photos?',
      faqJpgA: 'Choose one or more JPG images. Each photo is placed on its own page in a new PDF.',
      switchLanguage: 'Русская версия',
      compress: 'Compress PDF', compressHelp: 'Reduce the file size by converting pages to images.', compressQuality: 'Quality', compressButton: 'Compress and download',
      pages: 'PDF pages', pagesHelp: 'Enter page numbers in the order you want. Omitted pages will be removed. Choose pages below to rotate them.', rotatePages: 'Pages to rotate', pagesButton: 'Save pages', rotateButton: 'Rotate 90°',
      imagesPdf: 'JPG to PDF', imagesPdfHelp: 'Choose one or more JPG images. Each photo becomes a separate page.', imagesPdfButton: 'Create PDF',
      sign: 'Sign a PDF', signHelp: 'Add a drawn signature to a page in the editor.', signMode: 'Draw signature',
    }
const homeUrl = canonical(homePath(locale))
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.h1,
  description: copy.description,
  url: canonical(copy.path),
  inLanguage: locale,
  isPartOf: { '@type': 'WebSite', name: site.name, url: homeUrl },
}
---

<Base locale={locale} path={copy.path} title={copy.title} description={copy.description} imageAlt={copy.imageAlt} jsonLd={jsonLd}>
  <article class="page wrap pdf-page" data-pdf-tools data-locale={locale} data-font-url={hrefFor('/fonts/NotoSans-VF.ttf')}>
    <nav class="crumb" aria-label={locale === 'ru' ? 'Навигация' : 'Breadcrumb'}>
      <a href={hrefFor(homePath(locale))}>Foto</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{copy.crumb}</span>
    </nav>

    <header class="hero">
      <p class="kicker">PDF · {locale === 'ru' ? 'В вашем браузере' : 'In your browser'}</p>
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <ul class="trust">
        <li>{locale === 'ru' ? 'Без загрузки на сервер' : 'No upload'}</li>
        <li>{locale === 'ru' ? 'Бесплатно' : 'Free'}</li>
      </ul>
    </header>

    <nav class="pdf-language" aria-label={locale === 'ru' ? 'Язык страницы' : 'Page language'}>
      <a href={hrefFor(locale === 'ru' ? '/pdf-tools/' : '/ru/pdf-tools/')} lang={locale === 'ru' ? 'en' : 'ru'}>{copy.switchLanguage}</a>
    </nav>

    <section class="editor-card" aria-labelledby="editor-heading">
      <h2 id="editor-heading">{copy.editor}</h2>
      <p>{copy.editorHelp}</p>
      <div class="editor-toolbar">
        <label class="file-pick">
          <span>{copy.chooseDocument}</span>
          <input data-editor-file type="file" accept="application/pdf,.pdf" />
        </label>
        <label class="field page-control">
          <span>{copy.page}</span>
          <input data-page-number type="number" min="1" value="1" disabled />
        </label>
        <button class="text-btn" type="button" data-page-prev disabled>{copy.previous}</button>
        <span data-page-total class="page-total">/ 0</span>
        <button class="text-btn" type="button" data-page-next disabled>{copy.next}</button>
        <button class="btn" type="button" data-editor-save disabled>{copy.save}</button>
      </div>
      <div class="editor-options">
        <label class="field">
          <span>{copy.mode}</span>
          <select data-editor-mode>
            <option value="text">{copy.addText}</option>
            <option value="cover">{copy.cover}</option>
            <option value="image">{copy.addImage}</option>
            <option value="signature">{copy.signMode}</option>
          </select>
        </label>
        <label class="field text-option">
          <span>{copy.textLabel}</span>
          <textarea data-editor-text rows="2" placeholder={copy.textPlaceholder}></textarea>
        </label>
        <label class="field size-option">
          <span>{copy.textSize}</span>
          <input data-text-size type="number" min="6" max="96" value="18" />
        </label>
        <label class="field image-option" hidden>
          <span>{copy.imageLabel}</span>
          <input data-editor-image type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
        </label>
        <label class="field image-option" hidden>
          <span>{copy.imageWidth}</span>
          <input data-image-width type="number" min="24" max="600" value="180" />
        </label>
        <button class="text-btn" type="button" data-editor-undo disabled>{copy.undo}</button>
      </div>
      <div class="pdf-canvas-wrap" data-canvas-wrap hidden>
        <canvas data-pdf-canvas></canvas>
        <canvas data-edit-canvas aria-label={locale === 'ru' ? 'Область редактора PDF' : 'PDF editing area'}></canvas>
      </div>
      <p class="pdf-status" role="status" aria-live="polite" data-editor-status></p>
      <p class="local-note">{copy.editorNote}</p>
    </section>

    <div class="pdf-grid">
      <section class="pdf-card" aria-labelledby="compress-heading">
        <h2 id="compress-heading">{copy.compress}</h2>
        <p>{copy.compressHelp} {locale === 'ru' ? 'Страницы станут изображениями, текст нельзя будет выделять или искать.' : 'Pages become images, so text will no longer be selectable or searchable.'}</p>
        <label class="field"><span>{copy.compressQuality}</span><select data-compress-quality><option value="0.55">{locale === 'ru' ? 'Меньше файл' : 'Smaller file'}</option><option value="0.78" selected>{locale === 'ru' ? 'Сбалансированное' : 'Balanced'}</option><option value="0.92">{locale === 'ru' ? 'Выше качество' : 'Higher quality'}</option></select></label>
        <label class="file-pick"><span>{copy.chooseOne}</span><input data-compress-file type="file" accept="application/pdf,.pdf" /></label>
        <button class="btn" type="button" data-compress>{copy.compressButton}</button>
      </section>

      <section class="pdf-card" aria-labelledby="pages-heading">
        <h2 id="pages-heading">{copy.pages}</h2>
        <p>{copy.pagesHelp}</p>
        <label class="file-pick"><span>{copy.chooseOne}</span><input data-manage-file type="file" accept="application/pdf,.pdf" /></label>
        <label class="field"><span>{copy.pagesLabel}</span><input data-manage-order type="text" placeholder="1, 3-5, 2" /></label>
        <label class="field"><span>{copy.rotatePages}</span><input data-rotate-range type="text" placeholder="1-2" /></label>
        <button class="btn" type="button" data-manage-save>{copy.pagesButton}</button>
        <button class="text-btn" type="button" data-rotate>{copy.rotateButton}</button>
      </section>

      <section class="pdf-card" aria-labelledby="images-pdf-heading">
        <h2 id="images-pdf-heading">{copy.imagesPdf}</h2>
        <p>{copy.imagesPdfHelp}</p>
        <label class="file-pick"><span>{locale === 'ru' ? 'Выбрать JPG-фото' : 'Choose JPG images'}</span><input data-images-pdf-files type="file" accept="image/jpeg,.jpg,.jpeg" multiple /></label>
        <button class="btn" type="button" data-images-pdf>{copy.imagesPdfButton}</button>
      </section>

      <section class="pdf-card" aria-labelledby="merge-heading">
        <h2 id="merge-heading">{copy.merge}</h2>
        <p>{copy.mergeHelp}</p>
        <label class="file-pick">
          <span>{copy.chooseMany}</span>
          <input data-merge-files type="file" accept="application/pdf,.pdf" multiple />
        </label>
        <p class="file-summary" data-merge-summary aria-live="polite"></p>
        <button class="btn" type="button" data-merge>{copy.mergeButton}</button>
      </section>

      <section class="pdf-card" aria-labelledby="extract-heading">
        <h2 id="extract-heading">{copy.extract}</h2>
        <p>{copy.extractHelp}</p>
        <label class="file-pick">
          <span>{copy.chooseOne}</span>
          <input data-extract-file type="file" accept="application/pdf,.pdf" />
        </label>
        <label class="field">
          <span>{copy.pagesLabel}</span>
          <input data-page-range type="text" inputmode="text" placeholder={copy.pagesPlaceholder} />
        </label>
        <button class="btn" type="button" data-extract>{copy.extractButton}</button>
      </section>
    </div>
    <p class="local-note">{copy.sign}: {copy.signHelp}</p>

    <p class="local-note">{copy.localNote}</p>
    <p class="pdf-status" role="status" aria-live="polite" data-status></p>
    <section class="pdf-faq" aria-labelledby="pdf-faq-title">
      <h2 id="pdf-faq-title">{copy.faqTitle}</h2>
      <h3>{copy.faqEditQ}</h3>
      <p>{copy.faqEditA}</p>
      <h3>{copy.faqReplaceQ}</h3>
      <p>{copy.faqReplaceA}</p>
      <h3>{copy.faqMergeQ}</h3>
      <p>{copy.faqMergeA}</p>
      <h3>{copy.faqPrivacyQ}</h3>
      <p>{copy.faqPrivacyA}</p>
      <h3>{copy.faqCompressQ}</h3>
      <p>{copy.faqCompressA}</p>
      <h3>{copy.faqPagesQ}</h3>
      <p>{copy.faqPagesA}</p>
      <h3>{copy.faqJpgQ}</h3>
      <p>{copy.faqJpgA}</p>
    </section>
    <p><a href={hrefFor(homePath(locale))}>{copy.back}</a></p>
  </article>
</Base>

<style>
  .pdf-page .hero { margin-bottom: 24px; }
  .pdf-language { margin: -8px 0 20px; font-size: 0.95rem; }
  .pdf-faq { display: grid; gap: 10px; margin: 28px 0; }
  .pdf-faq h2, .pdf-faq h3, .pdf-faq p { margin: 0; }
  .pdf-faq h3 { margin-top: 8px; font-size: 1.05rem; }
  .editor-card {
    display: grid;
    gap: 14px;
    margin: 0 0 26px;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }
  .editor-card h2, .editor-card p { margin: 0; }
  .editor-toolbar, .editor-options { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .page-control { width: 90px; }
  .page-total { min-height: var(--tap); display: inline-flex; align-items: center; }
  .editor-options { padding: 14px; border: 1px solid var(--color-line); border-radius: var(--radius-m); }
  .editor-options select, .editor-options textarea { font: inherit; min-height: var(--tap); padding: 8px 10px; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-bg); color: var(--color-ink); }
  .editor-options textarea { min-width: min(360px, 70vw); }
  .size-option { width: 110px; }
  .image-option { max-width: min(360px, 100%); }
  .pdf-canvas-wrap { position: relative; width: fit-content; max-width: 100%; margin: 0 auto; overflow: auto; border: 1px solid var(--color-line); background: white; line-height: 0; }
  .pdf-canvas-wrap canvas { display: block; max-width: 100%; height: auto; }
  .pdf-canvas-wrap [data-edit-canvas] { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
  .editor-card .local-note { margin: 0; color: var(--color-ink-soft); }
  .pdf-grid { display: grid; gap: 16px; }
  .pdf-card {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }
  .pdf-card h2, .pdf-card p { margin: 0; }
  .pdf-card p { color: var(--color-ink-soft); }
  .file-pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: 0 16px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
    overflow: hidden;
  }
  .file-pick input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .field { display: grid; gap: 6px; }
  .field input {
    min-height: var(--tap);
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .file-summary, .pdf-status { min-height: 1.5em; }
  .local-note { margin-top: 18px; color: var(--color-ink-soft); }
  @media (min-width: 720px) {
    .pdf-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const root = document.querySelector('[data-pdf-tools]')
  if (root instanceof HTMLElement) {
    const ru = root.dataset.locale === 'ru'
    const text = {
      ready: ru ? 'Готово. Файл скачан.' : 'Done. Your file has been downloaded.',
      compressing: ru ? 'Сжимаем PDF…' : 'Compressing PDF…', creating: ru ? 'Создаём PDF…' : 'Creating PDF…',
      merging: ru ? 'Объединяем PDF…' : 'Merging PDFs…',
      extracting: ru ? 'Извлекаем страницы…' : 'Extracting pages…',
      errorFiles: ru ? 'Выберите PDF-файл или файлы.' : 'Choose one or more PDF files.',
      errorRange: ru ? 'Укажите корректные номера страниц, например 1-3, 5.' : 'Enter valid page numbers, for example 1-3, 5.',
      errorPage: ru ? 'Номер страницы вне диапазона этого PDF.' : 'A page number is outside this PDF’s range.',
      errorProcess: ru ? 'Не удалось обработать PDF. Убедитесь, что файл не повреждён и не защищён паролем.' : 'Could not process the PDF. Check that it is valid and not password protected.',
    }
    const status = root.querySelector('[data-status]')
    const mergeInput = root.querySelector('[data-merge-files]')
    const extractInput = root.querySelector('[data-extract-file]')
    const summary = root.querySelector('[data-merge-summary]')
    const rangeInput = root.querySelector('[data-page-range]')
    const compressInput = root.querySelector('[data-compress-file]')
    const compressQuality = root.querySelector('[data-compress-quality]')
    const manageInput = root.querySelector('[data-manage-file]')
    const manageOrder = root.querySelector('[data-manage-order]')
    const rotateRange = root.querySelector('[data-rotate-range]')

    const editorFile = root.querySelector('[data-editor-file]')
    const pageNumber = root.querySelector('[data-page-number]')
    const pageTotal = root.querySelector('[data-page-total]')
    const pagePrev = root.querySelector('[data-page-prev]')
    const pageNext = root.querySelector('[data-page-next]')
    const editorSave = root.querySelector('[data-editor-save]')
    const editorStatus = root.querySelector('[data-editor-status]')
    const canvasWrap = root.querySelector('[data-canvas-wrap]')
    const pdfCanvas = root.querySelector('[data-pdf-canvas]')
    const editCanvas = root.querySelector('[data-edit-canvas]')
    const editorMode = root.querySelector('[data-editor-mode]')
    const editorText = root.querySelector('[data-editor-text]')
    const textSize = root.querySelector('[data-text-size]')
    const editorImage = root.querySelector('[data-editor-image]')
    const imageWidth = root.querySelector('[data-image-width]')
    const editorUndo = root.querySelector('[data-editor-undo]')
    let sourceFile = null
    let sourceBytes = null
    let pdfDocument = null
    let currentPage = 1
    let currentViewport = null
    let editorItems = []
    let draft = null
    let pdfjsLib = null

    const loadPdfJs = async () => {
      if (pdfjsLib) return pdfjsLib
      const [library, worker] = await Promise.all([
        import('pdfjs-dist'),
        import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
      ])
      library.GlobalWorkerOptions.workerSrc = worker.default
      pdfjsLib = library
      return pdfjsLib
    }

    const loadPdfLib = async () => {
      return import('pdf-lib')
    }

    const loadFontkit = async () => {
      const module = await import('@pdf-lib/fontkit')
      return module.default ?? module
    }

    const editorMessages = {
      ready: ru ? 'PDF открыт. Выберите действие и нажмите или протяните курсор по странице.' : 'PDF opened. Choose an action, then click or drag on the page.',
      saved: ru ? 'Готово. Изменённая копия скачана.' : 'Done. Your edited copy has been downloaded.',
      error: ru ? 'Не удалось открыть или сохранить PDF. Файл может быть повреждён или защищён паролем.' : 'Could not open or save the PDF. The file may be damaged or password protected.',
      textMissing: ru ? 'Сначала введите текст.' : 'Enter some text first.',
      imageMissing: ru ? 'Сначала выберите PNG- или JPG-фото.' : 'Choose a PNG or JPG image first.',
      signatureMissing: ru ? 'Не удалось создать подпись.' : 'Could not create the signature.',
    }

    const editorItemsForPage = () => editorItems.filter((item) => item.page === currentPage)
    const drawEditorItems = () => {
      if (!(editCanvas instanceof HTMLCanvasElement) || !currentViewport) return
      const context = editCanvas.getContext('2d')
      if (!context) return
      const ratio = window.devicePixelRatio || 1
      context.setTransform(ratio, 0, 0, ratio, 0, 0)
      context.clearRect(0, 0, currentViewport.width, currentViewport.height)
      for (const item of editorItemsForPage()) {
        const x = item.x * currentViewport.width
        const y = item.y * currentViewport.height
        const width = item.width * currentViewport.width
        const height = item.height * currentViewport.height
        if (item.kind === 'cover') {
          context.fillStyle = '#ffffff'
          context.fillRect(x, y, width, height)
          context.strokeStyle = '#245b4a'
          context.setLineDash([5, 4])
          context.strokeRect(x, y, width, height)
          context.setLineDash([])
        } else if (item.kind === 'text') {
          context.fillStyle = item.color
          context.font = `${item.sizePt * currentViewport.scale}px sans-serif`
          context.textBaseline = 'top'
          item.text.split('\n').forEach((line, index) => context.fillText(line, x, y + index * item.sizePt * currentViewport.scale * 1.25))
        } else if (item.kind === 'image' && item.preview) {
          context.drawImage(item.preview, x, y, width, height)
        }
      }
      if (draft?.kind === 'cover') {
        context.fillStyle = 'rgba(255, 255, 255, 0.72)'
        context.fillRect(draft.x, draft.y, draft.width, draft.height)
        context.strokeStyle = '#245b4a'
        context.setLineDash([5, 4])
        context.strokeRect(draft.x, draft.y, draft.width, draft.height)
        context.setLineDash([])
      } else if (draft?.kind === 'signature' && draft.points.length > 1) {
        context.strokeStyle = '#171714'
        context.lineWidth = 2.5
        context.lineCap = 'round'
        context.lineJoin = 'round'
        context.beginPath()
        context.moveTo(draft.points[0].x, draft.points[0].y)
        draft.points.slice(1).forEach((point) => context.lineTo(point.x, point.y))
        context.stroke()
      }
      if (editorUndo instanceof HTMLButtonElement) editorUndo.disabled = editorItems.length === 0
    }

    const renderEditorPage = async () => {
      if (!pdfDocument || !(pdfCanvas instanceof HTMLCanvasElement) || !(editCanvas instanceof HTMLCanvasElement) || !(canvasWrap instanceof HTMLElement)) return
      const page = await pdfDocument.getPage(currentPage)
      const initial = page.getViewport({ scale: 1 })
      const availableWidth = canvasWrap.parentElement?.clientWidth || 780
      const scale = Math.max(0.2, Math.min(1.35, (availableWidth - 8) / initial.width))
      const viewport = page.getViewport({ scale })
      const ratio = window.devicePixelRatio || 1
      const pdfContext = pdfCanvas.getContext('2d')
      if (!pdfContext) return
      pdfCanvas.width = Math.floor(viewport.width * ratio)
      pdfCanvas.height = Math.floor(viewport.height * ratio)
      pdfCanvas.style.width = `${viewport.width}px`
      pdfCanvas.style.height = `${viewport.height}px`
      editCanvas.width = pdfCanvas.width
      editCanvas.height = pdfCanvas.height
      editCanvas.style.width = `${viewport.width}px`
      editCanvas.style.height = `${viewport.height}px`
      await page.render({ canvas: pdfCanvas, canvasContext: pdfContext, viewport, transform: ratio === 1 ? null : [ratio, 0, 0, ratio, 0, 0] }).promise
      currentViewport = viewport
      drawEditorItems()
      if (pageNumber instanceof HTMLInputElement) pageNumber.value = String(currentPage)
      if (pagePrev instanceof HTMLButtonElement) pagePrev.disabled = currentPage <= 1
      if (pageNext instanceof HTMLButtonElement) pageNext.disabled = currentPage >= pdfDocument.numPages
      if (pageTotal) pageTotal.textContent = `/ ${pdfDocument.numPages}`
    }

    editorFile?.addEventListener('change', async () => {
      const file = editorFile.files?.[0]
      if (!file || !(editorStatus instanceof HTMLElement) || !(canvasWrap instanceof HTMLElement)) return
      try {
        sourceFile = file
        sourceBytes = new Uint8Array(await file.arrayBuffer())
        const library = await loadPdfJs()
        pdfDocument = await library.getDocument({ data: sourceBytes.slice() }).promise
        currentPage = 1
        editorItems = []
        canvasWrap.hidden = false
        if (pageNumber instanceof HTMLInputElement) { pageNumber.disabled = false; pageNumber.max = String(pdfDocument.numPages) }
        if (editorSave instanceof HTMLButtonElement) editorSave.disabled = false
        editorStatus.textContent = editorMessages.ready
        await renderEditorPage()
      } catch {
        editorStatus.textContent = editorMessages.error
        canvasWrap.hidden = true
        if (editorSave instanceof HTMLButtonElement) editorSave.disabled = true
      }
    })

    pagePrev?.addEventListener('click', async () => { if (currentPage > 1) { currentPage--; await renderEditorPage() } })
    pageNext?.addEventListener('click', async () => { if (pdfDocument && currentPage < pdfDocument.numPages) { currentPage++; await renderEditorPage() } })
    pageNumber?.addEventListener('change', async () => {
      if (!pdfDocument || !(pageNumber instanceof HTMLInputElement)) return
      currentPage = Math.max(1, Math.min(pdfDocument.numPages, Number(pageNumber.value) || 1))
      await renderEditorPage()
    })
    editorMode?.addEventListener('change', () => {
      root.querySelectorAll('.image-option').forEach((element) => { if (element instanceof HTMLElement) element.hidden = editorMode.value !== 'image' })
      root.querySelectorAll('.text-option, .size-option').forEach((element) => { if (element instanceof HTMLElement) element.hidden = editorMode.value === 'image' || editorMode.value === 'signature' })
      if (editCanvas instanceof HTMLCanvasElement) editCanvas.style.cursor = editorMode.value === 'cover' ? 'crosshair' : 'copy'
    })
    editorUndo?.addEventListener('click', async () => {
      if (editorItems.length) {
        const item = editorItems.pop()
        item?.preview?.close?.()
        drawEditorItems()
        if (editorStatus instanceof HTMLElement) editorStatus.textContent = editorMessages.ready
      }
    })

    if (editCanvas instanceof HTMLCanvasElement) {
      editCanvas.addEventListener('pointerdown', (event) => {
        if (!currentViewport || !['cover', 'signature'].includes(editorMode?.value || '')) return
        const rect = editCanvas.getBoundingClientRect()
        const x = event.clientX - rect.left, y = event.clientY - rect.top
        draft = editorMode?.value === 'signature' ? { kind: 'signature', points: [{ x, y }] } : { kind: 'cover', x, y, width: 0, height: 0 }
        editCanvas.setPointerCapture(event.pointerId)
      })
      editCanvas.addEventListener('pointermove', (event) => {
        if (!draft) return
        const rect = editCanvas.getBoundingClientRect()
        if (draft.kind === 'signature') draft.points.push({ x: event.clientX - rect.left, y: event.clientY - rect.top })
        else { draft.width = event.clientX - rect.left - draft.x; draft.height = event.clientY - rect.top - draft.y }
        drawEditorItems()
      })
      editCanvas.addEventListener('pointerup', async (event) => {
        if (!currentViewport) return
        const rect = editCanvas.getBoundingClientRect()
        const x = event.clientX - rect.left
        const y = event.clientY - rect.top
        if (draft?.kind === 'cover') {
          const left = Math.max(0, Math.min(draft.x, x))
          const top = Math.max(0, Math.min(draft.y, y))
          const width = Math.min(currentViewport.width - left, Math.abs(x - draft.x))
          const height = Math.min(currentViewport.height - top, Math.abs(y - draft.y))
          if (width > 5 && height > 5) editorItems.push({ kind: 'cover', page: currentPage, scale: currentViewport.scale, x: left / currentViewport.width, y: top / currentViewport.height, width: width / currentViewport.width, height: height / currentViewport.height })
          draft = null
        } else if (draft?.kind === 'signature') {
          const stroke = draft
          draft = null
          if (stroke.points.length > 1) {
            const xs = stroke.points.map((point) => point.x), ys = stroke.points.map((point) => point.y)
            const left = Math.min(...xs), top = Math.min(...ys), width = Math.max(12, Math.max(...xs) - left), height = Math.max(12, Math.max(...ys) - top)
            const canvas = document.createElement('canvas'), scale = 2
            canvas.width = Math.ceil(width * scale); canvas.height = Math.ceil(height * scale)
            const context = canvas.getContext('2d')
            if (context) {
              context.scale(scale, scale); context.strokeStyle = '#171714'; context.lineWidth = 2.5; context.lineCap = 'round'; context.lineJoin = 'round'; context.beginPath()
              context.moveTo(stroke.points[0].x - left, stroke.points[0].y - top)
              stroke.points.slice(1).forEach((point) => context.lineTo(point.x - left, point.y - top)); context.stroke()
              const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'))
              if (blob instanceof Blob) {
                const bytes = new Uint8Array(await blob.arrayBuffer()), preview = await createImageBitmap(blob)
                editorItems.push({ kind: 'image', page: currentPage, scale: currentViewport.scale, x: left / currentViewport.width, y: top / currentViewport.height, width: width / currentViewport.width, height: height / currentViewport.height, bytes, mime: 'image/png', preview })
              }
            }
          }
        } else if (editorMode?.value === 'text') {
          const value = editorText instanceof HTMLTextAreaElement ? editorText.value.trim() : ''
          const size = textSize instanceof HTMLInputElement ? Math.max(6, Math.min(96, Number(textSize.value) || 18)) : 18
          if (!value) { if (editorStatus instanceof HTMLElement) editorStatus.textContent = editorMessages.textMissing; return }
          editorItems.push({ kind: 'text', page: currentPage, scale: currentViewport.scale, x: x / currentViewport.width, y: y / currentViewport.height, width: 0.5, height: Math.min(0.4, (size * 1.25 * value.split('\n').length) / currentViewport.height), text: value, sizePt: size / currentViewport.scale, color: '#171714' })
        } else if (editorMode?.value === 'image') {
          const file = editorImage instanceof HTMLInputElement ? editorImage.files?.[0] : null
          if (!file || !/^image\/(png|jpeg)$/.test(file.type)) { if (editorStatus instanceof HTMLElement) editorStatus.textContent = editorMessages.imageMissing; return }
          const preview = await createImageBitmap(file)
          const width = imageWidth instanceof HTMLInputElement ? Math.max(24, Math.min(600, Number(imageWidth.value) || 180)) : 180
          const height = width * preview.height / preview.width
          editorItems.push({ kind: 'image', page: currentPage, scale: currentViewport.scale, x: x / currentViewport.width, y: y / currentViewport.height, width: width / currentViewport.width, height: height / currentViewport.height, bytes: new Uint8Array(await file.arrayBuffer()), mime: file.type, preview })
        }
        drawEditorItems()
        if (editorStatus instanceof HTMLElement) editorStatus.textContent = editorMessages.ready
      })
    }

    editorSave?.addEventListener('click', async (event) => {
      const button = event.currentTarget
      if (!(button instanceof HTMLButtonElement) || !sourceBytes || !sourceFile || !(editorStatus instanceof HTMLElement)) return
      button.disabled = true
      try {
        const { PDFDocument, rgb } = await loadPdfLib()
        const output = await PDFDocument.load(sourceBytes)
        let font = null
        if (editorItems.some((item) => item.kind === 'text')) {
          output.registerFontkit(await loadFontkit())
          const fontUrl = root.dataset.fontUrl
          if (!fontUrl) throw new Error('Missing Unicode font URL')
          const fontResponse = await fetch(fontUrl)
          if (!fontResponse.ok) throw new Error('Could not load Unicode font')
          font = await output.embedFont(await fontResponse.arrayBuffer(), { subset: true })
        }
        for (const item of editorItems) {
          const page = output.getPage(item.page - 1)
          const pageView = pdfDocument ? await pdfDocument.getPage(item.page) : null
          if (!pageView) continue
          const viewport = pageView.getViewport({ scale: item.scale })
          const x = item.x * viewport.width
          const y = item.y * viewport.height
          const width = item.width * viewport.width
          const height = item.height * viewport.height
          const [x1, y1] = viewport.convertToPdfPoint(x, y)
          const [x2, y2] = viewport.convertToPdfPoint(x + width, y + height)
          if (item.kind === 'cover') {
            page.drawRectangle({ x: Math.min(x1, x2), y: Math.min(y1, y2), width: Math.abs(x2 - x1), height: Math.abs(y2 - y1), color: rgb(1, 1, 1) })
          } else if (item.kind === 'text') {
            if (!font) continue
            page.drawText(item.text, { x: x1, y: y1 - item.sizePt, size: item.sizePt, font, lineHeight: item.sizePt * 1.25, color: rgb(0.09, 0.09, 0.08) })
          } else if (item.kind === 'image') {
            const image = item.mime === 'image/png' ? await output.embedPng(item.bytes) : await output.embedJpg(item.bytes)
            page.drawImage(image, { x: Math.min(x1, x2), y: Math.min(y1, y2), width: Math.abs(x2 - x1), height: Math.abs(y2 - y1) })
          }
        }
        download(await output.save(), safeName(sourceFile.name) + '-edited.pdf')
        editorStatus.textContent = editorMessages.saved
      } catch {
        editorStatus.textContent = editorMessages.error
      } finally {
        button.disabled = false
      }
    })

    const download = (bytes, filename) => {
      const blob = new Blob([bytes], { type: 'application/pdf' })
      const url = URL.createObjectURL(blob)
      const link = document.createElement('a')
      link.href = url
      link.download = filename
      link.click()
      setTimeout(() => URL.revokeObjectURL(url), 30000)
    }
    const safeName = (name) => name.replace(/\.pdf$/i, '').replace(/[^\p{L}\p{N}._-]+/gu, '-') || 'document'
    const outputName = (names, suffix) => names.slice(0, 2).map(safeName).join('-') + (names.length > 2 ? '-and-more' : '') + suffix + '.pdf'

    root.querySelector('[data-images-pdf]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget, input = root.querySelector('[data-images-pdf-files]')
      if (!(button instanceof HTMLButtonElement) || !(input instanceof HTMLInputElement) || !input.files?.length || !status) { if (status) status.textContent = text.errorFiles; return }
      button.disabled = true; status.textContent = text.creating
      try {
        const { PDFDocument } = await loadPdfLib(), output = await PDFDocument.create()
        for (const file of input.files) {
          const image = await output.embedJpg(await file.arrayBuffer()), page = output.addPage([image.width, image.height])
          page.drawImage(image, { x: 0, y: 0, width: image.width, height: image.height })
        }
        download(await output.save(), 'photos.pdf'); status.textContent = text.ready
      } catch { status.textContent = text.errorProcess } finally { button.disabled = false }
    })

    root.querySelector('[data-compress]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget, file = compressInput instanceof HTMLInputElement ? compressInput.files?.[0] : null
      if (!(button instanceof HTMLButtonElement) || !file || !status) { if (status) status.textContent = text.errorFiles; return }
      button.disabled = true; status.textContent = text.compressing
      try {
        const [pdfjs, { PDFDocument }] = await Promise.all([loadPdfJs(), loadPdfLib()])
        const source = await pdfjs.getDocument({ data: new Uint8Array(await file.arrayBuffer()) }).promise
        const output = await PDFDocument.create()
        const quality = Number(compressQuality instanceof HTMLSelectElement ? compressQuality.value : 0.78)
        for (let index = 1; index <= source.numPages; index++) {
          const page = await source.getPage(index), viewport = page.getViewport({ scale: 1 })
          const scale = Math.max(0.1, Math.min(1.5, Math.sqrt(2_000_000 / (viewport.width * viewport.height))))
          const sized = page.getViewport({ scale })
          const canvas = document.createElement('canvas'); canvas.width = Math.ceil(sized.width); canvas.height = Math.ceil(sized.height)
          const context = canvas.getContext('2d')
          if (!context) throw new Error('Canvas is not available')
          await page.render({ canvas, canvasContext: context, viewport: sized }).promise
          const blob = await new Promise((resolve, reject) => canvas.toBlob((result) => result ? resolve(result) : reject(new Error('JPEG encoding failed')), 'image/jpeg', quality))
          const image = await output.embedJpg(await blob.arrayBuffer()), target = output.addPage([viewport.width, viewport.height])
          target.drawImage(image, { x: 0, y: 0, width: viewport.width, height: viewport.height })
          canvas.width = 0; canvas.height = 0
          page.cleanup()
        }
        const result = await output.save(), originalSize = file.size
        download(result, safeName(file.name) + '-compressed.pdf')
        status.textContent = result.byteLength < originalSize
          ? `${text.ready} ${ru ? `Размер: ${(originalSize / 1024).toFixed(0)} → ${(result.byteLength / 1024).toFixed(0)} КБ.` : `Size: ${(originalSize / 1024).toFixed(0)} → ${(result.byteLength / 1024).toFixed(0)} KB.`}`
          : (ru ? 'PDF обработан, но файл не стал меньше. Попробуйте качество ниже.' : 'PDF processed, but the file did not get smaller. Try lower quality.')
      } catch { status.textContent = text.errorProcess } finally { button.disabled = false }
    })

    const parsePageList = (input, count) => {
      if (!(input instanceof HTMLInputElement)) return null
      const pages = parseRange(input.value)
      return pages && pages.every((page) => page < count) ? pages : null
    }

    root.querySelector('[data-manage-save]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget, file = manageInput instanceof HTMLInputElement ? manageInput.files?.[0] : null
      if (!(button instanceof HTMLButtonElement) || !file || !(manageOrder instanceof HTMLInputElement) || !status) { if (status) status.textContent = text.errorFiles; return }
      button.disabled = true
      try {
        const { PDFDocument } = await loadPdfLib(), input = await PDFDocument.load(await file.arrayBuffer()), indices = parsePageList(manageOrder, input.getPageCount())
        if (!indices) { status.textContent = text.errorRange; return }
        const output = await PDFDocument.create(), copied = await output.copyPages(input, indices)
        copied.forEach((page) => output.addPage(page))
        download(await output.save(), safeName(file.name) + '-pages-edited.pdf'); status.textContent = text.ready
      } catch { status.textContent = text.errorProcess } finally { button.disabled = false }
    })

    root.querySelector('[data-rotate]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget, file = manageInput instanceof HTMLInputElement ? manageInput.files?.[0] : null
      if (!(button instanceof HTMLButtonElement) || !file || !status) { if (status) status.textContent = text.errorFiles; return }
      button.disabled = true
      try {
        const { PDFDocument, degrees } = await loadPdfLib(), input = await PDFDocument.load(await file.arrayBuffer()), indices = parsePageList(rotateRange, input.getPageCount())
        if (!indices) { status.textContent = text.errorRange; return }
        for (const index of indices) { const page = input.getPage(index); page.setRotation(degrees((page.getRotation().angle + 90) % 360)) }
        download(await input.save(), safeName(file.name) + '-rotated.pdf'); status.textContent = text.ready
      } catch { status.textContent = text.errorProcess } finally { button.disabled = false }
    })

    mergeInput?.addEventListener('change', () => {
      const files = [...(mergeInput.files ?? [])]
      if (summary) summary.textContent = files.map((file) => file.name).join(', ')
    })

    root.querySelector('[data-merge]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget
      if (!(button instanceof HTMLButtonElement) || !mergeInput?.files || !status) return
      const files = [...mergeInput.files]
      if (files.length < 2) { status.textContent = text.errorFiles; return }
      button.disabled = true
      status.textContent = text.merging
      try {
        const { PDFDocument } = await loadPdfLib()
        const output = await PDFDocument.create()
        for (const file of files) {
          const input = await PDFDocument.load(await file.arrayBuffer())
          const pages = await output.copyPages(input, input.getPageIndices())
          pages.forEach((page) => output.addPage(page))
        }
        download(await output.save(), outputName(files.map((file) => file.name), '-merged'))
        status.textContent = text.ready
      } catch {
        status.textContent = text.errorProcess
      } finally {
        button.disabled = false
      }
    })

    const parseRange = (value) => {
      const pages = []
      for (const part of value.split(',').map((item) => item.trim()).filter(Boolean)) {
        const match = part.match(/^(\d+)(?:\s*-\s*(\d+))?$/)
        if (!match) return null
        const first = Number(match[1])
        const last = Number(match[2] || match[1])
        if (first < 1 || last < first || last - first > 2000 || pages.length + last - first + 1 > 2000) return null
        for (let page = first; page <= last; page++) pages.push(page - 1)
      }
      return pages.length ? [...new Set(pages)] : null
    }

    root.querySelector('[data-extract]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget
      if (!(button instanceof HTMLButtonElement) || !extractInput?.files || !rangeInput || !status) return
      const file = extractInput.files[0]
      const pages = parseRange(rangeInput.value)
      if (!file) { status.textContent = text.errorFiles; return }
      if (!pages) { status.textContent = text.errorRange; return }
      button.disabled = true
      status.textContent = text.extracting
      try {
        const { PDFDocument } = await loadPdfLib()
        const input = await PDFDocument.load(await file.arrayBuffer())
        if (pages.some((page) => page >= input.getPageCount())) {
          status.textContent = text.errorPage
          return
        }
        const output = await PDFDocument.create()
        const copied = await output.copyPages(input, pages)
        copied.forEach((page) => output.addPage(page))
        download(await output.save(), safeName(file.name) + '-pages.pdf')
        status.textContent = text.ready
      } catch {
        status.textContent = text.errorProcess
      } finally {
        button.disabled = false
      }
    })
  }
</script>
